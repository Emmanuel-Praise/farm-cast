# Copy to Farm/.env (repo root, where the app runs) and fill in. Open-Meteo needs no key.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=farmcast-verify-token
ADMIN_TOKEN=change-me
DATABASE_PATH=./farmcast.db
TIMEZONE=Africa/Douala
DRY_RUN=false

# AI: OpenRouter primary -> NVIDIA NIM fallback -> rule-based reply (never empty)
PENROUTER_API_KEY=
TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
VISION_MODEL=nex-agi/nex-n2.5-pro:free
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Speech-to-text for inbound farmer voice notes (elevenlabs scribe)
SPEECH_PROVIDER=elevenlabs
SPEECH_MODEL=scribe_v1

# Outbound voice-note replies (OFF unless true — text replies are the default)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_REPLIES=false
